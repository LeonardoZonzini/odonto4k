# Endereço público do app (sem barra no final)
APP_URL=https://app.odonto4k.com.br

# Pasta onde ficam o banco e as fotos (na VPS, um volume do Docker)
DATA_DIR=./data

# E-mails que acessam /admin (separados por vírgula)
ADMIN_EMAILS=

# OpenAI (lentes e alinhamento por IA)
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_IMAGE_QUALITY=medium

# E-mail transacional (Resend)
RESEND_API_KEY=
EMAIL_FROM=Odonto 4K <contato@odonto4k.com.br>

# Kiwify
KIWIFY_WEBHOOK_TOKEN=
# ID do produto do FRONT do funil (aceita vários, separados por vírgula): quem compra recebe o acesso ao app
KIWIFY_PRODUTO_FRONT=
# Desvio de teste: 1 = qualquer pessoa cria conta (use só enquanto a Kiwify não está ligada). Vazio = só compradores.
CADASTRO_ABERTO=
KIWIFY_PRODUTO_PRO=
KIWIFY_PRODUTO_CLINICA=
KIWIFY_PRODUTO_PACOTE=
KIWIFY_LINK_PRO_MENSAL=
KIWIFY_LINK_PRO_ANUAL=
KIWIFY_LINK_CLINICA_MENSAL=
KIWIFY_LINK_CLINICA_ANUAL=
KIWIFY_LINK_PACOTE=

# Suporte
SUPORTE_WHATSAPP=
